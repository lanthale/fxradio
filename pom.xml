    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>${kotlin.jvmTarget}</jvmTarget>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <enablePreview>true</enablePreview>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <argLine>${app.jvmargs}</argLine>
                </configuration>
            </plugin>

            <!-- Jar: FxRadio.jar direkt in den jpackage-Input, Class-Path auf lib/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>          
                    <outputDirectory>${project.build.directory}/jpackage/input</outputDirectory>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>${mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Runtime-Dependencies nach jpackage/input/lib kopieren -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/jpackage/input/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>3.12.1</version>
            </plugin>

            <!-- Start mit: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                    <options>
                        <option>--add-opens=javafx.controls/javafx.scene.control.skin=ALL-UNNAMED</option>
                        <option>--add-opens=javafx.graphics/javafx.scene=ALL-UNNAMED</option>
                        <option>--add-opens=javafx.controls/javafx.scene.control=ALL-UNNAMED</option>
                        <option>--add-opens=javafx.base/com.sun.javafx.event=ALL-UNNAMED</option>
                        <option>--add-opens=javafx.base/com.sun.javafx.collections=ALL-UNNAMED</option>
                        <option>--add-opens=javafx.base/com.sun.javafx.runtime=ALL-UNNAMED</option>
                        <option>--add-opens=javafx.graphics/com.sun.javafx.scene=ALL-UNNAMED</option>
                        <option>--add-opens=javafx.graphics/com.sun.javafx.scene.traversal=ALL-UNNAMED</option>
                        <option>--add-exports=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED</option>
                        <option>--enable-native-access=ALL-UNNAMED</option>
                        <option>--enable-native-access=javafx.graphics</option>
                        <option>--enable-preview</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
    
    <reporting>
        <plugins>
            <!-- http://mojo.codehaus.org/versions-maven-plugin/version-rules.html -->
            <!-- This plugin is a utility to find outdated dependencies in your project. Just run mvn site and
           the resulting HTML reports in target/site will let you know what plugins and dependencies are out of date.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.11.0</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>dependency-updates-report</report>
                            <report>plugin-updates-report</report>
                            <report>property-updates-report</report>
                        </reports>
                    </reportSet>
                </reportSets>
                <configuration>
                    <processDependencyManagementTransitive>false</processDependencyManagementTransitive>
                </configuration>
            </plugin>            
        </plugins>
    </reporting>

    <profiles>        

        <!-- macOS-DMG: mvn -Pjpackage-mac package -->
        <profile>
            <id>jpackage-mac</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-dmg</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>dmg</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage/input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>fxradio-${version}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>${mainClass}</argument>
                                        <argument>--name</argument>
                                        <argument>FXRadio</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--description</argument>
                                        <argument>Internet Radio Directory</argument>
                                        <argument>--vendor</argument>
                                        <argument>FXRadio</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/jpackage/output</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/src/main/deploy/package/mac/FxRadio.icns</argument>
                                        <argument>--java-options</argument>
                                        <argument>--add-opens=javafx.controls/javafx.scene.control.skin=ALL-UNNAMED</argument>
                                        <argument>--java-options</argument>
                                        <argument>--add-opens=javafx.graphics/javafx.scene=ALL-UNNAMED</argument>
                                        <argument>--java-options</argument>
                                        <argument>--add-opens=javafx.controls/javafx.scene.control=ALL-UNNAMED</argument>
                                        <argument>--java-options</argument>
                                        <argument>--add-opens=javafx.base/com.sun.javafx.event=ALL-UNNAMED</argument>
                                        <argument>--java-options</argument>
                                        <argument>--add-opens=javafx.base/com.sun.javafx.collections=ALL-UNNAMED</argument>
                                        <argument>--java-options</argument>
                                        <argument>--add-opens=javafx.base/com.sun.javafx.runtime=ALL-UNNAMED</argument>
                                        <argument>--java-options</argument>
                                        <argument>--add-opens=javafx.graphics/com.sun.javafx.scene=ALL-UNNAMED</argument>
                                        <argument>--java-options</argument>
                                        <argument>--add-opens=javafx.graphics/com.sun.javafx.scene.traversal=ALL-UNNAMED</argument>
                                        <argument>--java-options</argument>
                                        <argument>--add-exports=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED</argument>
                                        <argument>--java-options</argument>
                                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                                        <argument>--java-options</argument>
                                        <argument>--enable-native-access=javafx.graphics</argument>
                                        <argument>--java-options</argument>
                                        <argument>--enable-preview</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
